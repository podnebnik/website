FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0.302-noble@sha256:72dd743782f2ae7e5476fd64f6a460045e3998dc862218b80e6944cba79a01b0 AS builder
ARG NODE_MAJOR=24

WORKDIR /build

RUN apt-get update && apt-get install -y ca-certificates curl gnupg git && mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg;

RUN echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" > /etc/apt/sources.list.d/nodesource.list;

RUN apt-get update && apt-get install nodejs libvips-dev -y && corepack enable

COPY . /build

# Datasette base override baked into the JS bundle at build time. Deliberately
# UNSET for the stage/prod image (docker-web.yaml passes nothing): the shared
# resolver (code/datasette-base.ts) then picks same-origin /data per host, so one
# image serves both environments. docker-preview.yaml passes it per-PR: `/data`
# when the PR ships its own preview datasette, the stage base otherwise.
ARG VITE_DATASETTE_URL=
ENV VITE_DATASETTE_URL=$VITE_DATASETTE_URL

RUN dotnet tool restore && yarn install && yarn run build

# -----------------------------------------------------------------------------

FROM nginx:1.31

# The nginx image's envsubst renders the template below into
# /etc/nginx/conf.d/default.conf at container start. It no longer substitutes
# anything — the site is static — but the templates/ mechanism is kept so
# adding a variable later needs no Dockerfile change.
COPY --from=builder /build/dist/ /usr/share/nginx/html/
COPY deployment/default.conf.template /etc/nginx/templates/default.conf.template

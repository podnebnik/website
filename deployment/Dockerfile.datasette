# This Dockerfile uses docker multi stage build to avoid having big image.
# https://docs.docker.com/build/building/multi-stage/
#
# To build only the "builder" stage, one can do:
# docker build --target=builder --progress=plain -f deployment/Dockerfile.datasette .

FROM ghcr.io/astral-sh/uv:0.9.26-python3.13-trixie-slim AS uv_setup

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends sqlite3 curl ca-certificates

# -----------------------------------------------------------------------------

# ── T-5.9: the numpy-heavy pipeline runs ONCE, in a separate CI job ────────────
# The builder stage computes the shipped SQLite (the .db files plus datasette
# inspect/metadata JSON under /build/var/sqlite). That output is a set of plain
# files, architecture-independent by construction, yet it is expensive to compute
# (numpy/scipy/statsmodels). The previous approach let the multi-arch image build
# generate it per target platform, which meant a second run under QEMU arm64
# emulation — measured on PR #456 as a multi-hour job (amd64 imported everything
# in 174 s; emulated arm64 took ~25 min for daily_window alone and was still early
# in annual_trend at 36 min). T-5.9's first attempt (761f520) tried to collapse
# that to one run by pinning this stage to $BUILDPLATFORM; it did NOT dedup — the
# arm64 sub-graph still executed `builder` under emulation (CI run 30094685030,
# `[linux/arm64 builder 7/9] RUN ... precompute_datasette.py`), because `builder`
# is based on the internal, un-pinned `uv_setup` stage and BuildKit does not
# reliably share such a vertex across target sub-graphs.
#
# The fix does not rely on BuildKit inference at all. generation is now driven by
# the CI: the `generate-db` job in .github/workflows/docker-data.yaml builds ONLY
# the `db-export` target below, on amd64, and exports /build/var/sqlite to a file
# it uploads as an artifact. The multi-arch image build (the `docker` job) never
# touches this stage — it downloads that artifact and COPYs it (see the runtime
# stage). There is exactly one generation step by construction, so the emulated
# run cannot come back.
#
# This does NOT reintroduce the arm64 skip T-5.7c removed: generation still runs
# unconditionally and still feeds both the amd64 and the arm64 image — it simply
# runs once on amd64 for both, instead of being recomputed under emulation for
# arm64. There is no committed derived CSV to fall back on, so a skip would ship an
# empty database; nothing here skips.
FROM uv_setup AS builder

WORKDIR /build

#  Note: docker caches image building so uncomment and change next line
#  when you change tasks.py or data to make sure they are pulled fresh into image
# RUN echo cache busting!

COPY pyproject.toml .python-version uv.lock tasks.py ./
COPY data /build/data

RUN uv sync --group build --locked

RUN ls -al /build/

# ── T-5.7c: the shipped climate-si tables are GENERATED from raw, not committed ──
# The derived climate-si.*.csv are no longer in git (T-5.7c untracked them); the
# only committed climate-si inputs are the raw per-station CSVs under
# data/climate-si/data/raw/. So generation now runs BEFORE `invoke create-databases`
# and defines the shipped climate-si tables, where T-5.7b merely exercised it in
# parallel with the committed CSVs.
#
# precompute_datasette.py runs validate.py (pandera) in memory BEFORE it writes to
# SQLite, so a broken pipeline fails this build step — and because generation lives
# in the `generate-db` job that the `docker` job depends on, a failure here aborts
# the workflow and ships nothing rather than publishing a half-built DB.
# export_datasette_csv.py then materialises the nine derived CSVs at their
# datapackage.yaml paths, and `invoke create-databases` imports them (plus the
# still-committed emissions/temperature packages) exactly as before — building
# var/sqlite and the datasette metadata/inspect files unchanged.
RUN uv sync --project data/climate-si/sources --locked
# T-4.24: pin BLAS/OpenMP to a single thread for the precompute. The tropical
# negative-binomial trend fit is ill-conditioned for a few near-flat count series,
# so its optimiser path is sensitive to floating-point reduction order — and with
# multi-threaded OpenBLAS that order varies run-to-run on the SAME amd64 runner,
# making `trend_json` non-reproducible between two builds of one commit (T-5.17
# found this; two native-amd64 runs produced different trend_json hashes). Single
# threaded, the reduction order is fixed and the build is reproducible. This is
# NECESSARY but NOT sufficient — a reproducible fit can still be an untrustworthy
# one, which is why _tropical_trend also withholds non-converged / singular fits.
# generate-db is the ONLY place the numpy-heavy pipeline runs (T-5.9), so pinning
# here covers every shipped value. The one-off cost is negligible at this data size.
RUN DATA_DIR=/build/data/climate-si/data/raw \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 \
    uv run --project data/climate-si/sources --no-sync \
        python data/climate-si/sources/precompute_datasette.py
RUN DB_PATH=/build/data/climate-si/data/raw/climate-si.db \
    OUT_DIR=/build/data/climate-si/data \
    uv run --project data/climate-si/sources --no-sync \
        python data/climate-si/sources/export_datasette_csv.py

# ── T-5.17: fail the build if a derived table's bytes moved without the manifest ──
# The nine CSVs export_datasette_csv.py just wrote are hashed and compared to the
# committed data/climate-si/derived-tables.sha256. A pipeline change that moves
# published output fails HERE — in the amd64 `generate-db` job, the ONLY place
# generation runs (T-5.9) — until the manifest is regenerated in the same commit,
# exactly as re-recording fixtures already is. This is T-5.3a's sha256 proof made
# permanent, and unlike `yarn snapshot:check` it does NOT depend on a redeployed
# stage: it catches a moved pipeline that a green snapshot cannot see.
RUN TABLES_DIR=/build/data/climate-si/data \
    uv run --project data/climate-si/sources --no-sync \
        python data/climate-si/sources/check_table_hashes.py \
        --manifest data/climate-si/derived-tables.sha256

# --no-validate-arch=aarch64 skips the slow frictionless validation only under
# arm64 emulation. This stage now always runs natively on amd64 (platform.machine()
# == x86_64), so the guard is a no-op and the full validation runs — unchanged from
# the pre-T-5.9 amd64 behaviour.
RUN uv run invoke create-databases --no-validate-arch=aarch64

# -----------------------------------------------------------------------------

# ── T-5.9: export-only stage — the artifact the `generate-db` job ships ─────────
# `docker buildx build --target db-export --output type=local,dest=<dir>` writes
# just the generated var/sqlite contents (the .db files and the datasette
# metadata/inspect JSON) to <dir>. FROM scratch keeps the artifact minimal: it is
# the pipeline output and nothing else.
FROM scratch AS db-export
COPY --from=builder /build/var/sqlite /

# -----------------------------------------------------------------------------

# ── T-5.9: runtime image — built multi-arch, COPYs the pre-generated DB ─────────
# This is the only stage the multi-arch `docker` job builds (target: runtime). It
# does NOT depend on `builder`, so building it for arm64 never runs the numpy
# pipeline under emulation. The `uv sync` here installs datasette itself and is the
# legitimately per-arch work.
#
# /datasette/sqlite comes from deployment/generated-sqlite/ in the build context —
# the `generate-db` job's artifact, downloaded before this build. The directory is
# absent on a plain checkout, so the runtime target is NOT standalone-buildable by
# design; it is only ever built by the `docker` job after the artifact download.
FROM uv_setup AS runtime

WORKDIR /datasette

COPY pyproject.toml .python-version uv.lock ./

RUN uv sync --locked

COPY deployment/generated-sqlite /datasette/sqlite

EXPOSE 8001
# TODO: remove custom setting when no longer needed
CMD uv run datasette serve --host 0.0.0.0 --port 8001 --cors --inspect-file sqlite/inspect-data.json --metadata sqlite/metadata.json ./sqlite/*.db  --setting max_returned_rows 150000

# This Dockerfile uses docker multi stage build to avoid having big image.
# https://docs.docker.com/build/building/multi-stage/
#
# To build only the "builder" stage, one can do:
# docker build --target=builder --progress=plain -f deployment/Dockerfile.datasette .

FROM ghcr.io/astral-sh/uv:0.9.26-python3.13-trixie-slim AS uv_setup

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends sqlite3 curl ca-certificates

# -----------------------------------------------------------------------------

# ── T-5.9: generate the shipped SQLite ONCE, on the native build platform ──────
# The builder runs the numpy-heavy precompute pipeline. Its whole output — the
# .db files plus the datasette inspect/metadata JSON under /build/var/sqlite — is
# a set of plain files, architecture-independent by construction. Pinning this
# stage to $BUILDPLATFORM makes BuildKit resolve it to the *same* (native amd64
# CI runner) vertex for every requested target platform, so it is computed once
# and reused, rather than once per arch. Before T-5.9 this heavy stage ran per
# target platform, which meant a full second run under QEMU arm64 emulation:
# measured on PR #456, amd64 imported everything in 174 s while emulated arm64
# took ~25 min for daily_window alone and was still early in annual_trend at 36
# min — a multi-hour job for a byte-identical file. Both image variants now COPY
# the single generated var/sqlite (see the final stage), so the emulated run is
# gone rather than merely faster.
#
# This does NOT reintroduce the arm64 skip T-5.7c removed: generation still runs
# unconditionally and still feeds both the amd64 and the arm64 image — it simply
# runs on amd64 for both, instead of being recomputed under emulation for arm64.
# There is no committed derived CSV to fall back on, so a skip would ship an
# empty database; nothing here skips.
FROM --platform=$BUILDPLATFORM uv_setup AS builder

WORKDIR /build

#  Note: docker caches image building so uncomment and change next line
#  when you change tasks.py or data to make sure they are pulled fresh into image
# RUN echo cache busting!

COPY pyproject.toml .python-version uv.lock tasks.py ./
COPY data /build/data

RUN uv sync --group build --locked

RUN ls -al /build/

# ── T-5.7c: the shipped climate-si tables are GENERATED from raw, not committed ──
# The derived climate-si.*.csv are no longer in git (T-5.7c untracked them); the
# only committed climate-si inputs are the raw per-station CSVs under
# data/climate-si/data/raw/. So generation now runs BEFORE `invoke create-databases`
# and defines the shipped climate-si tables, where T-5.7b merely exercised it in
# parallel with the committed CSVs.
#
# Generation is unconditional (no arch skip — T-5.7c removed that, T-5.9 keeps it
# removed). Because this whole stage is pinned to $BUILDPLATFORM above, it runs
# once natively on amd64 and its var/sqlite feeds both the amd64 and the arm64
# image; the arm64 image no longer regenerates anything under emulation.
#
# precompute_datasette.py runs validate.py before it writes, so a broken pipeline
# fails the build here. export_datasette_csv.py then materialises the nine derived
# CSVs at their datapackage.yaml paths, and `invoke create-databases` imports them
# (plus the still-committed emissions/temperature packages) exactly as before —
# building var/sqlite and the datasette metadata/inspect files unchanged.
RUN uv sync --project data/climate-si/sources --locked
RUN DATA_DIR=/build/data/climate-si/data/raw \
    uv run --project data/climate-si/sources --no-sync \
        python data/climate-si/sources/precompute_datasette.py
RUN DB_PATH=/build/data/climate-si/data/raw/climate-si.db \
    OUT_DIR=/build/data/climate-si/data \
    uv run --project data/climate-si/sources --no-sync \
        python data/climate-si/sources/export_datasette_csv.py

RUN uv run invoke create-databases --no-validate-arch=aarch64

# -----------------------------------------------------------------------------

FROM uv_setup

WORKDIR /datasette

COPY pyproject.toml .python-version uv.lock ./

RUN uv sync --locked

COPY --from=builder /build/var/sqlite /datasette/sqlite

EXPOSE 8001
# TODO: remove custom setting when no longer needed
CMD uv run datasette serve --host 0.0.0.0 --port 8001 --cors --inspect-file sqlite/inspect-data.json --metadata sqlite/metadata.json ./sqlite/*.db  --setting max_returned_rows 150000

# This Dockerfile uses docker multi stage build to avoid having big image.
# https://docs.docker.com/build/building/multi-stage/
#
# To build only the "builder" stage, one can do:
# docker build --target=builder --progress=plain -f deployment/Dockerfile.datasette .

FROM ghcr.io/astral-sh/uv:0.9.26-python3.13-trixie-slim AS uv_setup

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends sqlite3 curl ca-certificates

# -----------------------------------------------------------------------------

FROM uv_setup AS builder

WORKDIR /build

#  Note: docker caches image building so uncomment and change next line
#  when you change tasks.py or data to make sure they are pulled fresh into image
# RUN echo cache busting!

COPY pyproject.toml .python-version uv.lock tasks.py ./
COPY data /build/data

RUN uv sync --group build --locked

RUN ls -al /build/

RUN uv run invoke create-databases --no-validate-arch=aarch64

# ── T-5.7b: teach the image build to generate the derived tables from raw ───────
# The step above (invoke create-databases) is the committed-CSV path: it imports
# data/climate-si/data/climate-si.*.csv into var/sqlite and defines what the image
# ships. The step below ADDS the generation path — it runs precompute_datasette.py
# against the raw per-station inputs (data/climate-si/data/raw/), using the
# T-3.8-pinned pipeline deps in data/climate-si/sources/uv.lock. Both paths
# coexist by design (D-9): generation is exercised and validated here, but the
# shipped DBs still come from the committed CSVs above. Switching the source of
# truth (and untracking the derived CSVs) is T-5.7c, not this ticket.
#
# The generator writes its DB into the raw dir (DATA_DIR/climate-si.db); it never
# touches /build/var/sqlite, so it cannot alter the shipped data. precompute runs
# validate.py before writing, so a broken pipeline fails the build here.
#
# Skipped on emulated arm64 to bound CI cost — mirroring the existing
# --no-validate-arch=aarch64 pragma above. The shipped data is identical across
# arches (it comes from the committed CSVs), so exercising generation on the
# native amd64 build is sufficient.
ARG TARGETARCH
RUN uv sync --project data/climate-si/sources --locked
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        echo "T-5.7b: skipping raw->DB generation on emulated $TARGETARCH; committed-CSV path already built."; \
    else \
        DATA_DIR=/build/data/climate-si/data/raw \
        uv run --project data/climate-si/sources --no-sync \
            python data/climate-si/sources/precompute_datasette.py; \
    fi

# -----------------------------------------------------------------------------

FROM uv_setup

WORKDIR /datasette

COPY pyproject.toml .python-version uv.lock ./

RUN uv sync --locked

COPY --from=builder /build/var/sqlite /datasette/sqlite

EXPOSE 8001
# TODO: remove custom setting when no longer needed
CMD uv run datasette serve --host 0.0.0.0 --port 8001 --cors --inspect-file sqlite/inspect-data.json --metadata sqlite/metadata.json ./sqlite/*.db  --setting max_returned_rows 150000
